pipeline {
    agent any
    triggers { githubPush() }

    environment {
        APP_DIR = '/home/ubuntu/terraformassign/backend'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

         stage('Install Dependencies') {
            steps {
                sh '''
                    sudo -u ubuntu $APP_DIR/venv/bin/pip install -r $APP_DIR/requirements.txt
                '''
            }
        }

        stage('Deploy Code') {
            steps {
                sh '''
                    test -d $APP_DIR || { echo "Missing $APP_DIR"; exit 1; }
                    sudo -u ubuntu rsync -a \
                        --exclude='.env' --exclude='venv/' --exclude='__pycache__/' \
                        backend/ $APP_DIR/
                '''
            }
        }

        stage('Restart with PM2') {
            steps {
                sh '''
                    sudo -u ubuntu env HOME=/home/ubuntu PM2_HOME=/home/ubuntu/.pm2 bash -c '
                        cd /home/ubuntu/terraformassign/backend
                        if pm2 describe backend >/dev/null 2>&1; then
                            pm2 restart backend --update-env
                        else
                            pm2 start venv/bin/gunicorn --name backend --interpreter none -- -w 2 -b 0.0.0.0:5000 app:app
                        fi
                        pm2 save
                    '
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    for i in $(seq 1 15); do
                        curl --fail --silent -o /dev/null http://127.0.0.1:5000/ && exit 0
                        sleep 2
                    done
                    echo "Backend health check failed"; exit 1
                '''
            }
        }
    }

    post {
        success { echo 'Backend deployed successfully.' }
        failure { echo 'Backend deployment failed.' }
    }
}