pipeline {
    agent any
    triggers { githubPush() }

    environment {
        APP_DIR = '/home/ubuntu/terraformassign/frontend'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Install Dependencies') {
            steps {
                sh 'sudo -u ubuntu npm install --prefix $APP_DIR'
            }
        }

        stage('Deploy Code') {
            steps {
                sh '''
                    test -d $APP_DIR || { echo "Missing $APP_DIR"; exit 1; }
                    sudo -u ubuntu rsync -a \
                        --exclude='.env' --exclude='node_modules/' \
                        frontend/ $APP_DIR/
                '''
            }
        }


        stage('Restart with PM2') {
            steps {
                sh '''
                    sudo -u ubuntu env HOME=/home/ubuntu PM2_HOME=/home/ubuntu/.pm2 bash -c '
                        cd /home/ubuntu/terraformassign/frontend
                        if pm2 describe frontend >/dev/null 2>&1; then
                            pm2 restart frontend --update-env
                        else
                            pm2 start npm --name frontend -- start
                        fi
                        pm2 save
                    '
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    for i in $(seq 1 15); do
                        curl --fail --silent -o /dev/null http://127.0.0.1:3000/ && exit 0
                        sleep 2
                    done
                    echo "Frontend health check failed"; exit 1
                '''
            }
        }
    }

    post {
        success { echo 'Frontend deployed successfully.' }
        failure { echo 'Frontend deployment failed.' }
    }
}